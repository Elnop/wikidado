{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "factor": {
            "$ref": "common.schema.json#/$defs/factor"
          },
          "filled_by": {
            "$ref": "common.schema.json#/$defs/filled_by"
          },
          "values": {
            "enum": [
              "types",
              "families",
              "cards"
            ]
          },
          "status": {
            "$ref": "common.schema.json#/$defs/status"
          }
        },
        "required": [
          "id",
          "factor",
          "filled_by",
          "values",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "filters"
  ],
  "additionalProperties": false
}
