{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared definitions of the mechanics catalogue",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "card_type": {
      "enum": [
        "place",
        "creature",
        "event",
        "object",
        "knowledge",
        "faction"
      ]
    },
    "card_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card_type"
      },
      "uniqueItems": true
    },
    "text": {
      "type": "object",
      "properties": {
        "fr": {
          "type": "string"
        }
      },
      "required": [
        "fr"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "accepted",
        "proposed"
      ]
    },
    "factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "range": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        }
      ]
    },
    "filled_by": {
      "enum": [
        "model",
        "code"
      ]
    },
    "hint": {
      "type": "string",
      "minLength": 1
    }
  }
}
