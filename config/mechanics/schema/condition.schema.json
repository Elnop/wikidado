{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "factor": {
            "$ref": "common.schema.json#/$defs/factor"
          },
          "filled_by": {
            "$ref": "common.schema.json#/$defs/filled_by"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "n": {
            "$ref": "common.schema.json#/$defs/range"
          },
          "symmetric": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "text",
          "factor",
          "filled_by",
          "data",
          "n",
          "symmetric"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "conditions"
  ],
  "additionalProperties": false
}
