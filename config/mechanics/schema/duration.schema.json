{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "durations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/numbered_text"
          },
          "factor": {
            "$ref": "common.schema.json#/$defs/factor"
          }
        },
        "required": [
          "id",
          "text",
          "factor"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "durations"
  ],
  "additionalProperties": false
}
