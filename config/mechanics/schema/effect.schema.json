{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "kind": {
            "enum": [
              "triggered",
              "static"
            ]
          },
          "text": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "n": {
            "$ref": "common.schema.json#/$defs/range"
          },
          "cost": {
            "type": "object",
            "properties": {
              "per_n": {
                "type": "number"
              },
              "flat": {
                "type": "number"
              },
              "per_keyword_cost": {
                "type": "number"
              },
              "divisor": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "per_n",
              "flat",
              "per_keyword_cost",
              "divisor"
            ],
            "additionalProperties": false
          },
          "has_duration": {
            "type": "boolean"
          },
          "duration_text": {
            "type": "object",
            "additionalProperties": {
              "$ref": "common.schema.json#/$defs/text"
            }
          },
          "targets": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "affected_types": {
            "$ref": "common.schema.json#/$defs/card_types"
          },
          "zone": {
            "enum": [
              "board",
              "hand",
              "discard"
            ]
          },
          "takes_keyword": {
            "type": "boolean"
          },
          "hint": {
            "$ref": "common.schema.json#/$defs/hint"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/status"
          }
        },
        "required": [
          "id",
          "kind",
          "text",
          "n",
          "cost",
          "has_duration",
          "targets",
          "affected_types",
          "zone",
          "takes_keyword",
          "hint",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "effects"
  ],
  "additionalProperties": false
}
