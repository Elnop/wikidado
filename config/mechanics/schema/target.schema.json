{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "factor": {
            "$ref": "common.schema.json#/$defs/factor"
          },
          "is_player": {
            "type": "boolean"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/status"
          }
        },
        "required": [
          "id",
          "text",
          "factor",
          "is_player",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "targets"
  ],
  "additionalProperties": false
}
