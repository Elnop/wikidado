{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/text"
          },
          "types": {
            "$ref": "common.schema.json#/$defs/card_types"
          },
          "cost": {
            "type": "integer",
            "minimum": 1
          },
          "hint": {
            "$ref": "common.schema.json#/$defs/hint"
          }
        },
        "required": [
          "id",
          "name",
          "text",
          "types",
          "cost",
          "hint"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "keywords"
  ],
  "additionalProperties": false
}
