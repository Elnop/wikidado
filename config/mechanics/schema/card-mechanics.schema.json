{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mechanics assigned to a card: model output and sample annotations",
  "type": "object",
  "properties": {
    "article": {
      "type": "string",
      "pattern": "^Q[0-9]+$"
    },
    "mechanics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "keyword": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "trigger": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "effect": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "n": {
            "type": "integer"
          },
          "duration": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "target": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "filter": {
            "type": "object",
            "properties": {
              "type": {
                "$ref": "common.schema.json#/$defs/card_type"
              },
              "family": {
                "type": "string"
              },
              "card": {
                "type": "string",
                "pattern": "^Q[0-9]+$"
              }
            },
            "minProperties": 1,
            "maxProperties": 1,
            "additionalProperties": false
          },
          "granted_keyword": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "condition": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "n": {
                "type": "integer"
              },
              "card": {
                "type": "string",
                "pattern": "^Q[0-9]+$"
              },
              "filter": {
                "type": "object"
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        "oneOf": [
          {
            "required": [
              "keyword"
            ],
            "maxProperties": 1
          },
          {
            "required": [
              "effect",
              "target"
            ],
            "not": {
              "required": [
                "keyword"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "article",
    "mechanics"
  ],
  "additionalProperties": false
}
