{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "durees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "commun.schema.json#/$defs/id"
          },
          "texte": {
            "$ref": "commun.schema.json#/$defs/texte"
          },
          "facteur": {
            "$ref": "commun.schema.json#/$defs/facteur"
          },
          "statut": {
            "$ref": "commun.schema.json#/$defs/statut"
          }
        },
        "required": [
          "id",
          "texte",
          "facteur",
          "statut"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "durees"
  ],
  "additionalProperties": false
}
